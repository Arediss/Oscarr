# TMDB — optional, a built-in read access token is provided by default
# TMDB_API_TOKEN=your_own_tmdb_read_access_token
# Cookie security - set to 'true' in production behind reverse proxy

# ── Secrets ────────────────────────────────────────────────────────────────
# All three are refused at boot when left empty, kept at a placeholder, or too short.
# Oscarr prints a ready-to-paste value in that case, so a wrong guess costs one restart.
#
#   OSCARR_SECRET_KEY  openssl rand -hex 32       (encrypts stored service credentials)
#   JWT_SECRET         openssl rand -base64 32    (signs sessions — changing it signs everyone out)
#   SETUP_SECRET       openssl rand -base64 32    (guards the install wizard)
#
# OSCARR_SECRET_KEY is the one you must not lose: without it, stored credentials are
# unrecoverable and every service has to be reconfigured by hand.
OSCARR_SECRET_KEY=
JWT_SECRET=
SETUP_SECRET=

# App
PORT=3456
NODE_ENV=production
DATABASE_URL=file:../data/oscarr.db
FRONTEND_URL=http://localhost:5173
# COOKIE_SECURE=true
# Trust X-Forwarded-* headers. Unset (the default) means "trust nothing": correct when Oscarr is
# exposed directly, since otherwise any client can spoof its IP and reset its own rate limits.
# Behind a reverse proxy (Docker / Traefik / nginx / Caddy), set it to the proxy's IP or CIDR so
# real client IPs are read: TRUST_PROXY=172.18.0.0/16 — a bare `true` trusts every caller and is
# only safe when nothing but the proxy can reach the port. A hop count also works.
# TRUST_PROXY=127.0.0.1
INSTALL_FILE_PATH=./data/install.json
# BACKUP_MAX_SIZE_MB=500

# Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@oscarr.app

{
  "name": "@oscarr/backend",
  "version": "0.8.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:bundle": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "lock:prod": "cd \"$(mktemp -d)\" && cp \"$OLDPWD/package.prod.json\" package.json && npm install --package-lock-only --omit=dev --no-audit --no-fund && cp package-lock.json \"$OLDPWD/package.prod-lock.json\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@oscarr/shared": "*",
    "@prisma/client": "^6.19.3",
    "@types/archiver": "^8.0.0",
    "@types/tar": "^6.1.13",
    "archiver": "^8.0.0",
    "axios": "^1.17.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.1",
    "fastify": "^5.8.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "prisma": "^6.19.3",
    "resend": "^6.10.0",
    "semver": "^7.6.0",
    "tar": "^7.5.16",
    "undici": "^8.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/semver": "^7.7.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}

{
  "name": "@oscarr/backend",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run db:generate && tsc --strict",
    "build:bundle": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "lock:prod": "cd \"$(mktemp -d)\" && cp \"$OLDPWD/package.prod.json\" package.json && npm install --package-lock-only --omit=dev --no-audit --no-fund && cp package-lock.json \"$OLDPWD/package.prod-lock.json\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@oscarr/shared": "*",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "axios": "^1.21.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.1",
    "fastify": "^5.12.8",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.3.1",
    "prisma": "^6.19.3",
    "resend": "^6.37.0",
    "semver": "^7.8.6",
    "tar": "^7.5.16",
    "undici": "^8.12.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/semver": "^7.7.1",
    "dotenv-cli": "^11.1.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  }
}
